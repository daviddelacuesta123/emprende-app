# Proveedor de IA (actualmente solo "ollama" disponible)
LLM_PROVIDER=ollama

# URL del servidor Ollama (por defecto local)
OLLAMA_URL=http://localhost:11434

# Modelo a usar. Opciones recomendadas con 4GB VRAM:
#   llama3.2:3b   (2GB) — buena calidad, buen español
#   qwen2.5:3b    (2GB) — excelente español y multilenguaje
#   phi3:mini     (2.3GB) — rápido y eficiente
OLLAMA_MODEL=llama3.2:3b

# Puerto del servidor backend
PORT=3001
