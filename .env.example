# Supabase (cuentas y datos). La clave "publishable" está hecha para usarse en el navegador:
# no da acceso a datos ajenos porque cada tabla tiene RLS. Nunca pongas aquí la clave secreta
# (sb_secret_... o service_role).
VITE_SUPABASE_URL=https://cnsomjvdcvkplgxvnywf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Ev-6qWRYbCoXo40zp6rNZw_Afm8wrVL

# Muestra el botón "Continuar con Google". Ponlo en true solo después de activar Google
# en Supabase (Authentication → Sign In / Providers → Google). Ver README.
VITE_AUTH_GOOGLE=false

# Proveedor de IA (actualmente solo "ollama" disponible)
LLM_PROVIDER=ollama

# URL del servidor Ollama (por defecto local)
OLLAMA_URL=http://localhost:11434

# Modelo a usar. Opciones recomendadas con 4GB VRAM:
#   llama3.2:3b   (2GB) — buena calidad, buen español
#   qwen2.5:3b    (2GB) — excelente español y multilenguaje
#   phi3:mini     (2.3GB) — rápido y eficiente
OLLAMA_MODEL=llama3.2:3b

# Puerto del servidor backend
PORT=3001
